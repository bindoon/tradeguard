TRADEGUARD_DATABASE_URL=mysql+pymysql://tradeguard:tradeguard@127.0.0.1:53306/tradeguard?charset=utf8mb4
# Read-only legacy cache. Never use it as the runtime write database.
# TRADEGUARD_SELECTION_SOURCE_URL=mysql+pymysql://user:password@host/stock_market
# Optional read-only Longbridge account collector (install the longbridge extra).
# TRADEGUARD_LONGBRIDGE_APP_KEY=
# TRADEGUARD_LONGBRIDGE_APP_SECRET=
# TRADEGUARD_LONGBRIDGE_ACCESS_TOKEN=
# TRADEGUARD_LONGBRIDGE_REGION=cn
# Futu requires a local logged-in OpenD gateway, not an API key.
# TRADEGUARD_FUTU_HOST=127.0.0.1
# TRADEGUARD_FUTU_PORT=11111
# TRADEGUARD_FUTU_ACC_ID=
# TRADEGUARD_FUTU_SECURITY_FIRM=FUTUSECURITIES

# Optional read-only existing portfolio cache:
# TRADEGUARD_PORTFOLIO_SOURCE_URL=mysql+pymysql://user:password@host/portfolio
